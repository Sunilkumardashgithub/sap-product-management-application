
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="productValueHelpDialog"
        title="Select Products"
        noDataText="No products found"
        multiSelect="true"
        rememberSelections="true"
        items="{/Products}"
        search=".onProductValueHelpSearch"
        confirm=".onProductValueHelpConfirm"
        cancel=".onProductValueHelpCancel">

        <StandardListItem
            title="{Name}"
            description="Product ID: {ID}"
            type="Active"/>

    </SelectDialog>

</core:FragmentDefinition>
